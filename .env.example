# Ejemplo sin secretos. No copiar sobre .env existente.
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=CabezaDeAlgodon
JWT_SECRET=

# Activar solo después de revisar destinatarios y probar SMTP.
CORREO_HABILITADO=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_MESSAGE_DOMAIN=asilo.example
# Prueba real controlada: completar AMBAS para limitar el envío a un aviso y destinatario.
# No cambia el destinatario guardado. Si no coinciden, no se envía.
# Vacías: operación normal cuando CORREO_HABILITADO=true.
SMTP_SOLO_NOTIFICACION_ID=
SMTP_DESTINATARIO_PRUEBA=

# Activar solo tras 007, fechas verificadas y período de inicio aprobado en 009.
MENSUALIDADES_AUTOMATICAS=false
